[Unit]
Description=Pressure Cryptographic Authentication & Secret UID Authority
DefaultDependencies=no
Before=systemd-user-sessions.service display-manager.service getty.target
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/sbin/pressure-authd
Restart=always
RestartSec=1

[Install]
WantedBy=sysinit.target
